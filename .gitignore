# tests/security-test.sh fixtures. Kept between runs on purpose: the guard rightly refuses to
# unlink a .git/config, so they can only be cleared from the host. The two pre-refactor
# locations are listed until the stale directories are removed host-side.
tests/.state/
.sectest/
.sectest-probe/
