# Host-executed config guard — shipped with kib, mounted read-only from the repo.
#
# These rules are NOT a project's .kibignore. They are immune to negation: a project
# cannot write `!.git/config` and switch its own guard off. They are also tail-matched,
# so `.git/config` covers `sub/.git/config` and `.git/modules/x/config` — a repo cloned
# or `git init`ed mid-session is protected too, which a launch-time mount cannot do.
#
# Everything here is a file the *host* executes later. The sandbox writing one is the
# whole "week of sandbox escapes" bug class: the agent writes the future input of an
# unsandboxed system, and the host runs it at the next commit / editor open / shell cd.

[protect]
# Read-through, write-deny. These must stay readable: in-container git reads .git/config
# on virtually every command, so redacting it with the stub would break git outright.
#
# NOTE: git's own host-executed paths (.git/config, .git/hooks, and their submodule and
# worktree forms under .git/modules/<name>/ and .git/worktrees/<name>/) are NOT listed
# here. They nest arbitrarily deep, which a tail rule cannot express, so they live in
# Redact._git_sensitive() instead — one definition, shared with the write validator.
#
# ONLY files with an AMBIENT trigger belong here — ones the host runs at the next commit, `cd`,
# editor-open or ordinary tool invocation, with nobody deciding to run anything. A write here is
# refused and the policy text tells the agent to stop and report, so a rule on a file anyone edits
# day to day ends the session over ordinary work.
#
# Everything whose trigger is a DELIBERATE `claude` launch — .claude/settings.json, .mcp.json,
# .claude/hooks/, a .claude-plugin/ manifest, mise.toml, … — is DETECTED instead, by
# audit_project_configs() in kib/host/gitaudit.py. A report reaches the user before they launch;
# it cannot reach them before a `git status`. That is the whole basis of the split.
.vscode
.devcontainer
.envrc

# .idea — WITHDRAWN 2026-07-30, and this is a real hole, not a cleanup.
# It broke `pnpm install` in a JetBrains project (the install writes under .idea/ and got EPERM),
# and a [protect] refusal ends the session, so an unrelated ordinary command could not complete.
# What is now unguarded: .idea/workspace.xml carries the RunManager run configurations, and
# .idea/watcherTasks.xml carries File Watchers — the IDE runs the first when you press Run and
# the second on every save, unprompted. So a session can leave a command behind that the host
# executes at the next IDE interaction. Re-add the rule if you use JetBrains on this machine and
# nothing needs to write there; otherwise `git diff .idea/` is the control.

# git indirection the .git/* guard does not reach: .githooks is the usual committed
# core.hooksPath target (already-trusted config, so the validator never sees a change), and
# .gitmodules names the URL and path a `git submodule update` acts on.
.githooks
.gitmodules

# Agent and editor config that carries a command rather than prompt text. Deliberately
# file-precise: .cursor/rules and .claude/commands are prompt text, which kib holds is not
# execution (see the shared-assets tiers in redaction-config-guard.md).
#
# .claude/hooks — WITHDRAWN 2026-08-01, and unlike .idea this is a correction, not a hole.
# Everything else in this section fires on an ordinary commit, `cd` or editor-open, with the user
# not thinking about Claude at all; nothing under .claude/hooks/ loads until a POINTER names it
# (settings.json, a plugin manifest, skill frontmatter) and someone launches `claude`. That is a
# deliberate act a report reaches in time — and the pointer was always writable, so refusing the
# script while the thing that arms it stayed editable protected nothing. It also blocked the one
# sanctioned way to ship a repo-local committed hook: a plugin's hooks/hooks.json lives here.
# Now DETECTED, tree-wide, by audit_project_configs() + _since_stamp() in kib/host/gitaudit.py —
# the mtime half matters because the box can `git commit` past a dirty-file filter.
.cursor/mcp.json
.zed/tasks.json
.zed/debug.json
.run

# Tool config whose value is an executable, run by the host at the next ordinary command.
.mvn/jvm.config
.exrc
.nvim.lua
.ripgreprc
.yarnrc.yml

[redact]
# Stub on read + write-deny — the existing .kibignore behaviour. Secrets, not executables.
# Mirrors the "Redacted" tier in etc-CLAUDE.md.
#
# UNLIKE [protect], this tier is opt-out-able: a project .kibignore's `!` on the same path
# component cancels a rule here, so a repo whose .env holds no secrets can hand it over
# (`!.env`). What this tier withholds is the user's own secrets from their own session, which
# is theirs to waive; [protect] stops the box writing what the HOST later runs, and no repo may
# waive that. The launch prints every rule that opts out — the box can write .kibignore, so
# being SEEN is the whole control.
#
# '!' works here and applies within the guard set (last match wins). The placeholder files
# are committed by convention and contain no secrets — redacting them just breaks
# ordinary work like "add the new key to .env.example".
#
# Deliberately three names, not every placeholder convention in the wild. Each entry here
# is a file the agent may read in full, so the set is kept to spellings that are ALWAYS a
# committed template. `.env.defaults` and `.env.dist` were carried and removed (2026-07-27):
# both are also used for real per-environment values, and a wrong guess here leaks a secret
# while a wrong guess the other way costs one "ask the user".
.env
.env.*
!.env.example
!.env.sample
!.env.template

# The carve-out has to cover how a placeholder is actually WRITTEN. No atomic writer touches
# the target: it writes a sibling named after it and renames — Claude Code's Edit/Write use
# `<target>.tmp.<pid>.<rand>`, vim's `writebackup` (on by default) uses `<target>~`. Those
# names fall straight back through the three rules above into `.env.*`, so "add the new key to
# .env.example" failed with EPERM on a path nobody named. Only a copy of the placeholder can
# ever live at one of them, which is why they carry no read risk of their own.
#
# NOT `.env.example*`: that also re-admits `.env.example.local`, a real per-environment
# spelling — the `.env.dist` argument again, an open-ended prefix for a closed-set problem.
!.env.example.tmp.*
!.env.example~
!.env.sample.tmp.*
!.env.sample~
!.env.template.tmp.*
!.env.template~
