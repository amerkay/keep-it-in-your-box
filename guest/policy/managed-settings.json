{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }]
      }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "PermissionDenied": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input",
        "hooks": [{ "type": "command", "command": "python3 /etc/claude-code/sleep-hook.py", "timeout": 5 }]
      }
    ]
  }
}
