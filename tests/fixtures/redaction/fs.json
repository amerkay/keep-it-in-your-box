[
 {
  "name": "a protected path reads through",
  "project": "",
  "tree": {
   ".git/config": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://x/y\n",
   ".git/HEAD": "ref: refs/heads/main\n",
   ".git/objects/": ""
  },
  "steps": [
   {
    "op": "read",
    "path": ".git/config",
    "want": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://x/y\n"
   }
  ],
  "after": {
   ".git/": "",
   ".git/HEAD": "ref: refs/heads/main\n",
   ".git/config": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://x/y\n",
   ".git/objects/": ""
  }
 },
 {
  "name": "a redacted file reads as keys",
  "project": "",
  "tree": {
   ".env": "K=s3cr3t\n"
  },
  "steps": [
   {
    "op": "stat",
    "path": ".env",
    "want": {
     "type": "file",
     "perm": "0o444",
     "size": 13
    }
   },
   {
    "op": "read",
    "path": ".env",
    "want": "K=<redacted>\n"
   },
   {
    "op": "readdir",
    "path": "",
    "want": [
     ".env"
    ]
   }
  ],
  "after": {
   ".env": "K=s3cr3t\n"
  }
 },
 {
  "name": "a placeholder passes",
  "project": "",
  "tree": {
   ".env.example": "OLD=placeholder\n"
  },
  "steps": [
   {
    "op": "read",
    "path": ".env.example",
    "want": "OLD=placeholder\n"
   },
   {
    "op": "stat",
    "path": ".env.example",
    "want": {
     "type": "file",
     "perm": "0o644",
     "size": 16
    }
   }
  ],
  "after": {
   ".env.example": "OLD=placeholder\n"
  }
 },
 {
  "name": "a placeholder is edited through .env.example.tmp.170.e4cc80fbd4d5",
  "project": "",
  "tree": {
   ".env.example": "OLD=p\n"
  },
  "steps": [
   {
    "op": "put",
    "path": ".env.example.tmp.170.e4cc80fbd4d5",
    "data": "NEW=p\n",
    "want": "OK"
   },
   {
    "op": "rename",
    "path": ".env.example.tmp.170.e4cc80fbd4d5",
    "to": ".env.example",
    "want": "OK"
   }
  ],
  "after": {
   ".env.example": "NEW=p\n"
  }
 },
 {
  "name": "a placeholder is edited through .env.example~",
  "project": "",
  "tree": {
   ".env.example": "OLD=p\n"
  },
  "steps": [
   {
    "op": "put",
    "path": ".env.example~",
    "data": "NEW=p\n",
    "want": "OK"
   },
   {
    "op": "rename",
    "path": ".env.example~",
    "to": ".env.example",
    "want": "OK"
   }
  ],
  "after": {
   ".env.example": "NEW=p\n"
  }
 },
 {
  "name": "the write-sibling carve-out stops at secret names",
  "project": "",
  "tree": {},
  "steps": [
   {
    "op": "put",
    "path": ".env.tmp.170.abc",
    "data": "x\n",
    "want": "EPERM@open"
   },
   {
    "op": "put",
    "path": ".env.local~",
    "data": "x\n",
    "want": "EPERM@open"
   }
  ],
  "after": {}
 },
 {
  "name": "a redacted directory shows one marker",
  "project": "secrets",
  "tree": {
   "secrets/inner": "s3cr3t\n",
   "secrets/sub/x": "s3cr3t\n"
  },
  "steps": [
   {
    "op": "stat",
    "path": "secrets",
    "want": {
     "type": "dir",
     "perm": "0o555",
     "size": null
    }
   },
   {
    "op": "readdir",
    "path": "secrets",
    "want": [
     "REDACTED.md"
    ]
   },
   {
    "op": "read",
    "path": "secrets/REDACTED.md",
    "want": "STUB"
   },
   {
    "op": "stat",
    "path": "secrets/REDACTED.md",
    "want": {
     "type": "file",
     "perm": "0o444",
     "size": 256
    }
   },
   {
    "op": "stat",
    "path": "secrets/inner",
    "want": "ENOENT"
   },
   {
    "op": "read",
    "path": "secrets/inner",
    "want": "ENOENT"
   },
   {
    "op": "readdir",
    "path": "secrets/sub",
    "want": []
   },
   {
    "op": "put",
    "path": "secrets/new",
    "want": "EPERM@open"
   },
   {
    "op": "unlink",
    "path": "secrets/inner",
    "want": "EPERM"
   }
  ],
  "after": {
   "secrets/": "",
   "secrets/inner": "s3cr3t\n",
   "secrets/sub/": "",
   "secrets/sub/x": "s3cr3t\n"
  }
 },
 {
  "name": "inside a redacted FILE path",
  "project": "blob",
  "tree": {
   "blob": "s3cr3t\n"
  },
  "steps": [
   {
    "op": "stat",
    "path": "blob/x",
    "want": {
     "type": "file",
     "perm": "0o444",
     "size": 256
    }
   },
   {
    "op": "read",
    "path": "blob",
    "want": "STUB"
   }
  ],
  "after": {
   "blob": "s3cr3t\n"
  }
 },
 {
  "name": "a stub for an unknown shape",
  "project": "secret.pem",
  "tree": {
   "secret.pem": "-----BEGIN KEY-----\ns3cr3t\n"
  },
  "steps": [
   {
    "op": "read",
    "path": "secret.pem",
    "want": "STUB"
   },
   {
    "op": "stat",
    "path": "secret.pem",
    "want": {
     "type": "file",
     "perm": "0o444",
     "size": 256
    }
   }
  ],
  "after": {
   "secret.pem": "-----BEGIN KEY-----\ns3cr3t\n"
  }
 },
 {
  "name": "a masked path the host lacks is ENOENT, and stays unwritable",
  "project": "",
  "tree": {},
  "steps": [
   {
    "op": "stat",
    "path": ".env.local",
    "want": "ENOENT"
   },
   {
    "op": "open-r",
    "path": ".env.local",
    "want": "ENOENT"
   },
   {
    "op": "put",
    "path": ".env.local",
    "want": "EPERM@open"
   },
   {
    "op": "mkdir",
    "path": ".env.d",
    "want": "EPERM"
   }
  ],
  "after": {}
 },
 {
  "name": "every write to a redacted file is refused",
  "project": "",
  "tree": {
   ".env": "K=s3cr3t\n"
  },
  "steps": [
   {
    "op": "open-w",
    "path": ".env",
    "want": "EPERM"
   },
   {
    "op": "put",
    "path": ".env",
    "want": "EPERM@open"
   },
   {
    "op": "truncate",
    "path": ".env",
    "length": 0,
    "want": "EPERM"
   },
   {
    "op": "unlink",
    "path": ".env",
    "want": "EPERM"
   },
   {
    "op": "rename",
    "path": ".env",
    "to": "x",
    "want": "EPERM"
   },
   {
    "op": "link",
    "path": "alias",
    "to": ".env",
    "want": "EPERM"
   },
   {
    "op": "symlink",
    "path": "sl",
    "to": ".env",
    "want": "OK"
   },
   {
    "op": "read",
    "path": "sl",
    "want": "K=<redacted>\n"
   }
  ],
  "after": {
   ".env": "K=s3cr3t\n",
   "sl": "-> .env"
  }
 },
