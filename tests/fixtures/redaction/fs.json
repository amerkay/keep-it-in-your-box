 {
  "name": "guarded paths cannot be deleted",
  "project": "",
  "tree": {
   ".git/config": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://x/y\n",
   ".git/HEAD": "ref: refs/heads/main\n",
   ".git/objects/": "",
   ".vscode/settings.json": "{}\n",
   "sub/.githooks/pre-push": "x\n",
   ".envrc": "export FOO=1\n"
  },
  "steps": [
   {
    "op": "unlink",
    "path": ".vscode/settings.json",
    "want": "EPERM"
   },
   {
    "op": "unlink",
    "path": ".git/config",
    "want": "EPERM"
   },
   {
    "op": "unlink",
    "path": "sub/.githooks/pre-push",
    "want": "EPERM"
   },
   {
    "op": "unlink",
    "path": ".envrc",
    "want": "EPERM"
   },
   {
    "op": "rmdir",
    "path": ".vscode",
    "want": "EPERM"
   }
  ],
  "after": {
   ".envrc": "export FOO=1\n",
   ".git/": "",
   ".git/HEAD": "ref: refs/heads/main\n",
   ".git/config": "[core]\n\trepositoryformatversion = 0\n[remote \"origin\"]\n\turl = https://x/y\n",
   ".git/objects/": "",
   ".vscode/": "",
   ".vscode/settings.json": "{}\n",
   "sub/": "",
   "sub/.githooks/": "",
   "sub/.githooks/pre-push": "x\n"
  }
 },
