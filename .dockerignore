# The build context only needs the Dockerfile's inputs: guest/, kib/, requirements-dev.txt and
# the redaction fixtures the Go stage tests against. Everything else is either host-side, other
# tests, or caches that would bust the `COPY kib` layer on every lint run.
.git
.github
.venv
**/__pycache__
.mypy_cache
.ruff_cache
docs
examples
tests
!tests/fixtures/redaction
host
bin
tools
*.md
